 "rules": [
  "use only objects with learnedInUnit <= the unit the child has finished; record/relation phrases only from their learnedInUnit",
  "one letter per object; if there are fewer objects than letters, the word waits for a later unit",
  "never use a phrase that contains the answer word (e.g. no \"continent\" phrases for CONTINENT)",
  "only approved undisputed facts appear here; disputed facts (Southern Ocean coldest, Atlantic saltiest) are deliberately absent",
  "reveal order: no neighbouring positions in a row; first letter late; last letters not early (same checks as validate-geowords.mjs)",
  "bare directions (\"in the west\", \"on the Equator\"...) are used only in unit 1 (onlyInUnit: 1); after unit 1 a direction is always tied to a continent: \"in the west of Africa\" (decided by Svetlana 2026-10-23)",
  "parts exist only where the two opposite points are far enough apart on a phone (>= 7% of map width) and well inside the land",
  "a continent part never appears with its whole continent — not in one puzzle and not anywhere in the same unit (see continentModeByUnit); two parts of one continent in one puzzle only as an opposite pair (oppositeOf)"
 ],
 "approval": {
  "status": "approved",
  "by": "Svetlana",
  "date": "2026-10-23",
  "scope": "rules and phrases; review puzzles are spot-checked"
 },
