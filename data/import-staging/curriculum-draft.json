  "facts": [
    {
      "id": "f-l1-p06-continents",
      "status": "editorial_pending",
      "text": {
        "en": "There are seven continents on Earth: Asia, Africa, North America, South America, Antarctica, Europe, and Australia."
      },
      "sourceBlockId": "source-l1-p06-continents",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 6,
        "region": [
          225,
          115,
          740,
          175
        ]
      },
      "introducesPlaces": null,
      "category": "intro",
      "caveatFactIds": []
    },
    {
      "id": "f-l1-p06-eurasia",
      "status": "editorial_pending",
      "text": {
        "en": "Sometimes Europe and Asia are counted as one continent. Together, they are called Eurasia."
      },
      "sourceBlockId": "source-l1-p06-eurasia",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 6,
        "region": [
          435,
          180,
          740,
          268
        ]
      },
      "introducesPlaces": null,
      "category": "intro",
      "caveatFactIds": []
    },
    {
      "id": "f-l1-p06-oceans",
      "status": "editorial_pending",
      "text": {
        "en": "There are five oceans on Earth: the Pacific, Atlantic, Indian, Southern, and Arctic Oceans."
      },
      "sourceBlockId": "source-l1-p06-oceans",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 6,
        "region": [
          435,
          278,
          740,
          362
        ]
      },
      "introducesPlaces": null,
      "category": "intro",
      "caveatFactIds": []
    },
    {
      "id": "f-l1-p06-land-water",
      "status": "editorial_pending",
      "text": {
        "en": "Continents are very large areas of land. Oceans are very large areas of salt water."
      },
      "sourceBlockId": "source-l1-p06-land-water",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 6,
        "region": [
          435,
          375,
          740,
          476
        ]
      },
      "introducesPlaces": null,
      "category": "intro",
      "caveatFactIds": []
    },
    {
      "id": "f-l1-p06-pacific-map",
      "status": "editorial_pending",
      "text": {
        "en": "The Pacific Ocean appears on both sides of the map, but it is one ocean."
      },
      "sourceBlockId": "source-l1-p06-pacific-map",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 6,
        "region": [
          475,
          480,
          740,
          558
        ]
      },
      "introducesPlaces": null,
      "category": "intro",
      "caveatFactIds": []
    },
    {
      "id": "f-l1-p08-continent-properties",
      "status": "editorial_pending",
      "text": {
        "en": "Eurasia contains Europe and Asia. The largest continent is Asia. The smallest continent is Australia. The hottest continent is Africa. The coldest continent is Antarctica."
      },
      "sourceBlockId": "source-l1-p08-continent-properties",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 8,
        "region": [
          300,
          405,
          740,
          532
        ]
      },
      "introducesPlaces": null,
      "category": "bridge",
      "caveatFactIds": []
    },
    {
      "id": "f-l1-p10-oceans-left",
      "status": "editorial_pending",
      "text": {
        "en": "There are five oceans in the world. The smallest ocean is the Arctic Ocean. The coldest ocean is the Southern Ocean."
      },
      "sourceBlockId": "source-l1-p10-oceans-left",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 10,
        "region": [
          110,
          440,
          410,
          510
        ]
      },
      "introducesPlaces": null,
      "category": "bridge",
      "caveatFactIds": [
        "f-l1-p10-salinity-note"
      ]
    },
    {
      "id": "f-l1-p10-oceans-right",
      "status": "editorial_pending",
      "text": {
        "en": "The warmest ocean is the Indian Ocean. The deepest ocean is the Pacific Ocean. The saltiest ocean is the Atlantic Ocean.*"
      },
      "sourceBlockId": "source-l1-p10-oceans-right",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
        "pdfPage": 10,
        "region": [
          430,
          440,
          740,
          510
        ]
      },
      "introducesPlaces": null,
      "category": "bridge",
      "caveatFactIds": [
        "f-l1-p10-salinity-note"
      ]
    },
    {
      "id": "f-l1-p10-salinity-note",
      "status": "editorial_pending",
      "text": {
        "en": "*The Atlantic is considered the saltiest of the five oceans based on its average salinity. However, salinity varies from place to place, and some areas may be saltier or less salty than others."
      },
      "sourceBlockId": "source-l1-p10-salinity-note",
      "provenance": {
        "source": "Level 1 Oceans & Continents.pdf",
